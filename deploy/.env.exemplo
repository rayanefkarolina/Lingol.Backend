# Copie para ".env" na mesma pasta e preencha. O .env NUNCA vai para o Git.
#
#   cp .env.exemplo .env && nano .env

# Endereço público da API, registrado no DuckDNS (sem https://)
DOMINIO=lingol-api.duckdns.org

# Endereço do frontend na Cloudflare, exatamente como aparece no navegador,
# com https:// e sem barra no final
FRONTEND_URL=https://lingol.eduescola.workers.dev

# Banco de dados (o usuário e a senha são criados na primeira subida)
POSTGRES_USER=lingol
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Assinatura dos tokens de login. Precisa ter no mínimo 32 bytes.
# Gere uma nova com:  openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-nova-de-no-minimo-32-bytes

# Chave do Google AI Studio (gere uma nova, nunca reaproveite a de desenvolvimento)
GEMINI_API_KEY=
