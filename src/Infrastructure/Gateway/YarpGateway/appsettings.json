{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "pedagogico_route",
        "ClusterId": "pedagogico_cluster",
        "Match": {
          "Path": "/pedagogico/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/pedagogico" }
        ]
      },
      {
        "RouteId": "cadastro_route",
        "ClusterId": "cadastro_cluster",
        "Match": {
          "Path": "/cadastro/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/cadastro" }
        ]
      }
    ],
    "Clusters": {
      "pedagogico_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5000/"
          }
        }
      },
      "cadastro_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  }
}
